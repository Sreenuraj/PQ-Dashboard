{
  "name": "pq-dashboard",
  "displayName": "PostQode Dashboard & Testing Studio",
  "version": "1.0.0",
  "publisher": "postqode",
  "description": "PostQode AI Agent Observability, Network Inspector & Behavioral Testing Dashboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/postqode/pq-dashboard.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Testing",
    "Linters",
    "Programming Languages"
  ],
  "main": "extension/index.js",
  "type": "commonjs",
  "activationEvents": [
    "onView:pqDashboardSidebar",
    "onCommand:pq.openDashboard",
    "onCommand:pq.refreshData",
    "onCommand:pq.runTest",
    "onCommand:pq.addSource",
    "onCommand:pq.openSources",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pq.openDashboard",
        "title": "Open Full Dashboard",
        "category": "PostQode",
        "icon": "$(window)"
      },
      {
        "command": "pq.openInBrowser",
        "title": "Open in External Browser",
        "category": "PostQode",
        "icon": "$(globe)"
      },
      {
        "command": "pq.refreshData",
        "title": "Scan & Refresh Tasks Across IDEs",
        "category": "PostQode",
        "icon": "$(refresh)"
      },
      {
        "command": "pq.runTest",
        "title": "Run Behavioral Test Suite",
        "category": "PostQode",
        "icon": "$(beaker)"
      },
      {
        "command": "pq.startProxy",
        "title": "Enable Network Proxy Routing (Auto-Configure)",
        "category": "PostQode",
        "icon": "$(play)"
      },
      {
        "command": "pq.stopProxy",
        "title": "Disable Network Proxy Routing",
        "category": "PostQode",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pq.trustCertificate",
        "title": "Trust Proxy CA Certificate (HTTPS Decryption)",
        "category": "PostQode",
        "icon": "$(shield)"
      },
      {
        "command": "pq.addSource",
        "title": "Add Custom Task Folder...",
        "category": "PostQode",
        "icon": "$(folder-library)"
      },
      {
        "command": "pq.openSources",
        "title": "Configure Sources & Setup",
        "category": "PostQode",
        "icon": "$(gear)"
      },
      {
        "command": "pq.openSessions",
        "title": "Open Sessions in Dashboard",
        "category": "PostQode",
        "icon": "$(history)"
      },
      {
        "command": "pq.openCosts",
        "title": "Open Costs & Tokens in Dashboard",
        "category": "PostQode",
        "icon": "$(credit-card)"
      },
      {
        "command": "pq.openErrors",
        "title": "Open Error Breakdown in Dashboard",
        "category": "PostQode",
        "icon": "$(warning)"
      },
      {
        "command": "pq.openModels",
        "title": "Open Model Analytics in Dashboard",
        "category": "PostQode",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "pq.openNetwork",
        "title": "Open Network Inspector in Dashboard",
        "category": "PostQode",
        "icon": "$(radio-tower)"
      },
      {
        "command": "pq.openRoute",
        "title": "Open Page in Dashboard",
        "category": "PostQode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pq.openDashboard",
          "when": "view == pqDashboardSidebar",
          "group": "navigation@1"
        },
        {
          "command": "pq.openInBrowser",
          "when": "view == pqDashboardSidebar",
          "group": "navigation@2"
        },
        {
          "command": "pq.refreshData",
          "when": "view == pqDashboardSidebar",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pqDashboardContainer",
          "title": "PostQode Dashboard",
          "icon": "src/img/logo.svg"
        }
      ]
    },
    "views": {
      "pqDashboardContainer": [
        {
          "id": "pqDashboardSidebar",
          "name": "PostQode Observability & Testing"
        }
      ]
    }
  },
  "scripts": {
    "build": "vite build --config vite.config.js",
    "build:extension": "npm run build",
    "vscode:prepublish": "npm run build",
    "extension:package": "node scripts/package-extension.js",
    "extension:package:force": "node scripts/package-extension.js --force",
    "package": "npm run build && npx @vscode/vsce package",
    "package:nodeps": "npm run build && npx @vscode/vsce package --no-dependencies",
    "server": "nodemon server/index.js",
    "dev": "vite --config vite.config.js --port 5173 --open",
    "start": "node server/index.js",
    "parse": "node server/parser/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "chart.js": "^4.5.1",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "express": "^5.1.0",
    "http-mitm-proxy": "^1.1.0",
    "js-yaml": "^4.1.0",
    "playwright-core": "^1.63.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "nodemon": "^3.1.10",
    "vite": "^6.3.1"
  }
}
